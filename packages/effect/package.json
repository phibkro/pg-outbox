{
  "name": "@pg-outbox/effect",
  "version": "0.1.0-alpha.0",
  "description": "The Effect adapter of the pg-outbox core: enqueue and holdClaim require InTransaction in their type; a lost claim is a typed value.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "prepublishOnly": "echo 'publish packages/effect/dist (bun run release:stage), not the source directory' && exit 1",
    "test": "bunx vp test",
    "build": "vp pack"
  },
  "dependencies": {
    "@pg-outbox/core": "workspace:*",
    "@pg-txmode/effect": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@pg-outbox/conformance": "workspace:*",
    "@pg-txmode/harness": "0.1.0-alpha.1",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": ">=4.1.0 <4.2.0"
  }
}
