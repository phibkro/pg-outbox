{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "tools/quality": {
      "entry": ["checkExceptions.ts"],
      "project": ["*.ts", "test/**/*.ts"]
    },
    "packages/core": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/conformance": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/model": {
      "entry": ["run.ts", "test/**/*.test.ts"],
      "project": ["*.ts", "test/**/*.ts"]
    },
    "packages/pg": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/effect": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@effect/language-service"]
    }
  },
  "ignoreBinaries": ["gitleaks", "tlc"],
  "ignoreDependencies": ["vite"],
  "ignoreWorkspaces": ["vendor/**"],
  "exclude": ["catalog"]
}
